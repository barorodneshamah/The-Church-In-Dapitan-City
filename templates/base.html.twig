<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="The Church in Dapitan City — Gathering as the local expression of the Body of Christ in Dapitan City, Zamboanga del Norte.">
    <title>{% block title %}The Church in Dapitan City{% endblock %}</title>

    {# Bootstrap 5 #}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    {# Bootstrap Icons #}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    {# Google Fonts #}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">

    {% block stylesheets %}
    <style>
        /* =====================================================
           GLOBAL STYLES — The Church in Dapitan City
           ===================================================== */

        /* ---- Variables ---- */
        :root {
            --church-dark:    #0c1018;
            --church-navy:    #020A74;
            --church-gold:    #c9a84c;
            --church-gold-dk: #a8873a;
            --church-gold-lt: #e8d4a0;
            --church-cream:   #fffef6;
            --church-section: #F8F8F8;
            --church-white:   #ffffff;
            --church-text:    #0c1018;
            --church-muted:   #7D7D7D;
            --church-border:  #E5E5E5;
            --church-pale:    #cfd1e9;
            --font-heading:   'Playfair Display', serif;
            --font-body:      'Roboto', sans-serif;
            --shadow-sm:      0 2px 8px rgba(2,10,116,0.07);
            --shadow-md:      0 6px 24px rgba(2,10,116,0.10);
            --shadow-lg:      0 12px 40px rgba(2,10,116,0.13);
            --radius:         6px;
            --transition:     0.25s ease;
        }

        /* ---- Base Reset ---- */
        * { box-sizing: border-box; }
        html { scroll-behavior: smooth; }
        body {
            font-family: var(--font-body);
            color: var(--church-text);
            background: var(--church-cream);
            font-size: 15.5px;
            line-height: 1.75;
            -webkit-font-smoothing: antialiased;
        }
        h1, h2, h3, h4, h5, h6 {
            font-family: var(--font-heading);
            font-weight: 600;
            line-height: 1.3;
            letter-spacing: -0.01em;
        }
        a { color: var(--church-gold-dk); text-decoration: none; }
        a:hover { color: var(--church-gold); }

        /* ---- Top Bar ---- */
        .church-topbar {
            background: var(--church-dark);
            color: rgba(255,255,255,0.65);
            font-size: 0.78rem;
            padding: 6px 0;
            border-bottom: 1px solid rgba(201,168,76,0.2);
        }
        .church-topbar a { color: rgba(255,255,255,0.65); transition: color 0.2s; }
        .church-topbar a:hover { color: var(--church-gold); }
        .church-topbar .topbar-divider {
            display: inline-block;
            width: 1px;
            height: 12px;
            background: rgba(255,255,255,0.2);
            margin: 0 10px;
            vertical-align: middle;
        }

        /* ---- Navbar ---- */
        .church-navbar {
            background: rgba(255,255,255,0.97) !important;
            backdrop-filter: blur(12px);
            padding: 0;
            box-shadow: 0 2px 20px rgba(12,16,24,0.08);
            border-bottom: 1px solid var(--church-border);
            transition: box-shadow var(--transition), background var(--transition);
            position: sticky;
            top: 0;
            z-index: 1030;
        }
        .church-navbar .dropdown-menu {
            position: absolute !important;
            z-index: 9500 !important;
            pointer-events: auto !important;
        }
        .church-navbar .dropdown-item { pointer-events: auto !important; }
        .church-navbar .navbar-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 0;
            margin-right: 2.5rem;
            text-decoration: none;
        }
        .church-navbar .brand-logo {
            width: 80px;
            height: 80px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }
        .church-navbar .brand-logo svg { width: 24px; height: 24px; fill: var(--church-dark); }
        .church-navbar .brand-text { display: flex; flex-direction: column; line-height: 1.15; }
        .church-navbar .brand-pre {
            font-family: var(--font-body);
            font-size: 0.68rem;
            color: var(--church-muted);
            text-transform: uppercase;
            letter-spacing: 1.5px;
        }
        .church-navbar .brand-name {
            font-family: var(--font-heading);
            font-size: 1.05rem;
            color: var(--church-navy);
            font-weight: 700;
            white-space: nowrap;
        }
        .church-navbar .navbar-nav .nav-link {
            color: var(--church-navy) !important;
            font-family: var(--font-body);
            font-size: 0.75rem;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            padding: 1.4rem 0.55rem !important;
            position: relative;
            transition: color var(--transition);
        }
        .church-navbar .navbar-nav .nav-link:hover,
        .church-navbar .navbar-nav .nav-link.active { color: var(--church-gold-dk) !important; }
        .church-navbar .dropdown-menu {
            background: #fff;
            border: none;
            border-top: 2px solid var(--church-gold);
            border-radius: 0 0 var(--radius) var(--radius);
            margin-top: 0;
            min-width: 210px;
            box-shadow: var(--shadow-lg);
            padding: 0.6rem 0;
        }
        .church-navbar .dropdown-item {
            color: var(--church-navy);
            font-size: 0.82rem;
            font-weight: 400;
            letter-spacing: 0.3px;
            padding: 0.55rem 1.25rem;
            transition: all 0.2s;
        }
        .church-navbar .dropdown-item:hover {
            background: var(--church-cream);
            color: var(--church-gold-dk);
            padding-left: 1.55rem;
        }
        .church-navbar .dropdown-item i { width: 16px; margin-right: 6px; font-size: 0.8rem; opacity: 0.55; }
        .navbar-toggler { border: 1px solid rgba(0,0,0,0.15); padding: 4px 8px; }
        .navbar-toggler-icon {
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='rgba%2826%2C39%2C68%2C0.85%29' stroke-linecap='round' stroke-miterlimit='10' stroke-width='2' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e") !important;
        }
        .church-navbar .navbar-nav .nav-link.btn-nav-login {
            background: var(--church-gold);
            color: #fff !important;
            border-radius: 10px;
            padding: 0.38rem 1.15rem !important;
            line-height: 1.9;
            font-weight: 700;
            font-size: 0.74rem !important;
            letter-spacing: 0.8px;
            margin-left: 0.5rem;
            transition: all 0.25s;
            box-shadow: 0 3px 10px rgba(201,168,76,0.3);
            border: none;
        }
        .church-navbar .navbar-nav .nav-link.btn-nav-login:hover {
            background: var(--church-gold-dk);
            color: var(--church-dark) !important;
            box-shadow: 0 5px 16px rgba(201,168,76,0.45);
        }

        /* ---- Page Hero ---- */
        .page-hero {
            background:
                linear-gradient(135deg, rgba(2,10,116,0.84) 0%, rgba(2,10,116,0.60) 55%, rgba(201,168,76,0.38) 100%),
                url('/images/Pic1.jpg') center / cover no-repeat;
            padding: 6.5rem 0 5rem;
            text-align: center;
            position: relative;
            overflow: hidden;
        }
        .page-hero::before {
            content: '';
            position: absolute;
            bottom: 0; left: 0; right: 0;
            height: 3px;
            background: linear-gradient(90deg, transparent, var(--church-gold), transparent);
        }
        .page-hero h1 { color: #fff; font-size: 2.6rem; margin-bottom: 0.5rem; letter-spacing: -0.02em; }
        .page-hero .page-hero-divider {
            width: 55px; height: 3px;
            background: var(--church-gold);
            margin: 0.85rem auto 1rem;
            border-radius: 2px;
        }
        .page-hero .breadcrumb { justify-content: center; margin: 0; }
        .page-hero .breadcrumb-item,
        .page-hero .breadcrumb-item a { color: rgba(255,255,255,0.5); font-size: 0.83rem; }
        .page-hero .breadcrumb-item.active { color: var(--church-gold-lt); }
        .page-hero .breadcrumb-item + .breadcrumb-item::before { color: rgba(255,255,255,0.3); }

        /* ---- Section Utilities ---- */
        .section-label {
            font-family: var(--font-body);
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 3px;
            color: var(--church-gold-dk);
            margin-bottom: 0.5rem;
        }
        .section-title {
            font-family: var(--font-heading);
            font-size: clamp(1.6rem, 3vw, 2.2rem);
            color: var(--church-navy);
            margin-bottom: 0.5rem;
        }
        .section-divider {
            width: 50px; height: 3px;
            background: var(--church-gold);
            border-radius: 2px;
            margin: 0.75rem 0 1.5rem;
        }
        .section-divider.mx-auto { margin: 0.75rem auto 1.5rem; }
        .bg-church-cream   { background-color: var(--church-cream); }
        .bg-church-section { background-color: var(--church-section); }
        .bg-church-dark    { background-color: var(--church-dark); }
        .bg-church-navy    { background-color: var(--church-navy); }

        /* ---- Buttons ---- */
        .btn-church {
            background: var(--church-gold);
            color: var(--church-dark);
            border: none;
            padding: 0.7rem 2rem;
            font-family: var(--font-body);
            font-weight: 500;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            border-radius: var(--radius);
            transition: all var(--transition);
            display: inline-block;
            text-decoration: none;
        }
        .btn-church:hover {
            background: var(--church-gold-dk);
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(168,135,58,0.35);
        }
        .btn-church-outline {
            background: transparent;
            color: #fff;
            border: 1.5px solid rgba(255,255,255,0.45);
            padding: 0.65rem 1.8rem;
            font-family: var(--font-body);
            font-weight: 700;
            font-size: 0.82rem;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            border-radius: 2px;
            transition: all 0.25s;
            display: inline-block;
            text-decoration: none;
        }
        .btn-church-outline:hover { border-color: var(--church-gold); color: var(--church-gold); }
        .btn-church-outline-dark {
            background: transparent;
            color: var(--church-navy);
            border: 1.5px solid var(--church-navy);
            padding: 0.65rem 1.8rem;
            font-family: var(--font-body);
            font-weight: 700;
            font-size: 0.82rem;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            border-radius: 2px;
            transition: all 0.25s;
            display: inline-block;
            text-decoration: none;
        }
        .btn-church-outline-dark:hover {
            background: var(--church-navy);
            color: white;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(2,10,116,0.25);
        }
        .btn-church-sm { padding: 0.4rem 1.1rem; font-size: 0.77rem; }
        .btn-download {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: var(--church-section);
            border: 1px solid var(--church-border);
            color: var(--church-navy);
            padding: 0.4rem 1rem;
            font-size: 0.8rem;
            font-weight: 700;
            border-radius: 3px;
            transition: all 0.2s;
            text-decoration: none;
        }
        .btn-download:hover { background: var(--church-gold); border-color: var(--church-gold); color: white; }

        /* ---- Forms ---- */
        .form-label {
            font-weight: 700;
            font-size: 0.83rem;
            color: var(--church-navy);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 0.35rem;
        }
        .form-control {
            border: 1px solid var(--church-border);
            border-radius: 3px;
            font-size: 0.9rem;
            padding: 0.6rem 0.9rem;
            transition: border-color 0.2s, box-shadow 0.2s;
        }
        .form-control:focus {
            border-color: var(--church-gold);
            box-shadow: 0 0 0 3px rgba(201,168,76,0.15);
        }

        /* ---- Gallery Grid (shared — home + gallery pages) ---- */
        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 1rem;
        }
        .gallery-thumb {
            position: relative;
            overflow: hidden;
            border-radius: 3px;
            aspect-ratio: 4/3;
            background: var(--church-section);
            cursor: pointer;
        }
        .gallery-thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
        .gallery-thumb:hover img { transform: scale(1.07); }
        .gallery-thumb-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(to top, rgba(12,16,24,0.88) 0%, rgba(12,16,24,0) 55%);
            display: flex;
            align-items: flex-end;
            padding: 1rem;
            opacity: 0;
            transition: opacity 0.3s;
        }
        .gallery-thumb:hover .gallery-thumb-overlay { opacity: 1; }
        .gallery-thumb-overlay h5 { color: #fff; font-size: 0.9rem; margin: 0; font-family: var(--font-heading); }
        .gallery-thumb-placeholder {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: var(--church-muted);
            font-size: 0.88rem;
            gap: 0.5rem;
            height: 100%;
        }
        .gallery-thumb-placeholder i { font-size: 2rem; opacity: 0.4; }

        /* ---- Flash Messages ---- */
        .alert-success { background: #d4edda; border-color: #c3e6cb; color: #155724; border-radius: 3px; font-size: 0.9rem; }
        .alert-danger  { background: #f8d7da; border-color: #f5c6cb; color: #721c24; border-radius: 3px; font-size: 0.9rem; }

        /* ---- Empty State ---- */
        .empty-state { text-align: center; padding: 4rem 2rem; color: var(--church-muted); }
        .empty-state i { font-size: 3rem; opacity: 0.3; display: block; margin-bottom: 1rem; }
        .empty-state p { font-size: 0.95rem; }

        /* ---- Footer ---- */
        .church-footer { background: #010330; color: rgba(255,255,255,0.6); padding: 4rem 0 0; }
        .church-footer h5 {
            font-family: var(--font-heading);
            color: #fff;
            font-size: 1.05rem;
            margin-bottom: 1.25rem;
            padding-bottom: 0.75rem;
            border-bottom: 1px solid rgba(201,168,76,0.25);
        }
        .church-footer p { font-size: 0.87rem; line-height: 1.7; }
        .footer-tagline { font-size: 0.76rem !important; line-height: 1.75; }
        .church-footer a { color: rgba(255,255,255,0.55); font-size: 0.87rem; transition: color 0.2s; text-decoration: none; }
        .church-footer a:hover { color: var(--church-gold); }
        .church-footer ul { list-style: none; padding: 0; margin: 0; }
        .church-footer ul li { padding: 0.3rem 0; border-bottom: 1px solid rgba(255,255,255,0.05); font-size: 0.87rem; }
        .church-footer ul li:last-child { border-bottom: none; }
        .church-footer ul li a::before { content: '›  '; color: var(--church-gold); }
        .footer-social a {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 34px; height: 34px;
            border: 1px solid rgba(255,255,255,0.15);
            border-radius: 50%;
            color: rgba(255,255,255,0.55) !important;
            font-size: 0.9rem;
            transition: all 0.2s;
            margin-right: 6px;
        }
        .footer-social a:hover { background: var(--church-gold); border-color: var(--church-gold); color: white !important; }
        .footer-bottom {
            background: rgba(0,0,0,0.3);
            padding: 1.1rem 0;
            margin-top: 3rem;
            font-size: 0.8rem;
            text-align: center;
            color: rgba(255,255,255,0.35);
            border-top: 1px solid rgba(255,255,255,0.05);
        }

        /* ---- Misc Utilities ---- */
        .gold-text    { color: var(--church-gold); }
        .gold-dk-text { color: var(--church-gold-dk); }
        .navy-text    { color: var(--church-navy); }
        .muted-text   { color: var(--church-muted); }
        .bg-pale      { background-color: var(--church-pale); }
        .verse-block {
            border-left: 3px solid var(--church-gold);
            padding: 1rem 1.5rem;
            background: var(--church-cream);
            border-radius: 0 4px 4px 0;
            margin: 1.5rem 0;
        }
        .verse-block p { font-style: italic; color: var(--church-navy); margin: 0 0 0.3rem; font-size: 1.05rem; }
        .verse-block cite { font-size: 0.82rem; color: var(--church-gold-dk); font-weight: 700; font-style: normal; }
        .divider-gold {
            border: none;
            height: 1px;
            background: linear-gradient(90deg, transparent, var(--church-gold), transparent);
            margin: 2rem 0;
            opacity: 0.4;
        }

        /* ---- Reading Progress Bar ---- */
        #reading-progress {
            position: fixed;
            top: 0; left: 0;
            width: 0%; height: 3px;
            background: linear-gradient(90deg, var(--church-navy), var(--church-gold));
            z-index: 9999;
            transition: width 0.1s linear;
            border-radius: 0 2px 2px 0;
        }

        /* ---- Hero Eyebrow & Page-Hero Entrance Animations ---- */
        .hero-eyebrow {
            font-family: var(--font-body);
            font-size: 0.72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 3.5px;
            color: var(--church-gold-lt);
            opacity: 0.85;
            margin-bottom: 1rem;
            animation: heroFadeDown 0.7s ease both;
        }
        .page-hero h1            { animation: heroFadeDown 0.7s ease 0.1s both; }
        .page-hero .page-hero-divider { animation: heroExpandDivider 0.8s cubic-bezier(0.25,0.46,0.45,0.94) 0.5s both; }
        .page-hero .breadcrumb   { animation: heroFadeDown 0.6s ease 0.7s both; }
        @keyframes heroFadeDown {
            from { opacity: 0; transform: translateY(-14px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        @keyframes heroExpandDivider {
            from { width: 0; opacity: 0; }
            to   { width: 55px; opacity: 1; }
        }

        /* ---- Scroll Reveal ---- */
        [data-animate] {
            opacity: 0;
            transform: translateY(28px);
            transition: opacity 0.65s cubic-bezier(0.25,0.46,0.45,0.94),
                        transform 0.65s cubic-bezier(0.25,0.46,0.45,0.94);
        }
        [data-animate].is-visible { opacity: 1; transform: translateY(0); }
        [data-animate="fade-left"]  { transform: translateX(-24px); }
        [data-animate="fade-left"].is-visible  { transform: translateX(0); }
        [data-animate="fade-right"] { transform: translateX(24px); }
        [data-animate="fade-right"].is-visible { transform: translateX(0); }

        /* ---- Stagger Grid (row of Bootstrap cols animate in sequence) ---- */
        .stagger-grid > [class*="col"] {
            opacity: 0;
            transform: translateY(20px);
            transition: opacity 0.42s ease, transform 0.42s ease;
        }
        .stagger-grid.is-visible > [class*="col"] { opacity: 1; transform: translateY(0); }
        .stagger-grid.is-visible > [class*="col"]:nth-child(1) { transition-delay: 0.04s; }
        .stagger-grid.is-visible > [class*="col"]:nth-child(2) { transition-delay: 0.09s; }
        .stagger-grid.is-visible > [class*="col"]:nth-child(3) { transition-delay: 0.14s; }
        .stagger-grid.is-visible > [class*="col"]:nth-child(4) { transition-delay: 0.19s; }
        .stagger-grid.is-visible > [class*="col"]:nth-child(5) { transition-delay: 0.24s; }
        .stagger-grid.is-visible > [class*="col"]:nth-child(6) { transition-delay: 0.29s; }
        .stagger-grid.is-visible > [class*="col"]:nth-child(7) { transition-delay: 0.34s; }
        .stagger-grid.is-visible > [class*="col"]:nth-child(8) { transition-delay: 0.39s; }
        .stagger-grid.is-visible > [class*="col"]:nth-child(9) { transition-delay: 0.44s; }

        /* ---- Responsive ---- */
        @media (max-width: 991px) {
            .church-navbar .navbar-collapse { background: #fff; padding: 1rem; margin-top: 0.5rem; border-top: 2px solid var(--church-gold); box-shadow: 0 8px 20px rgba(0,0,0,0.1); }
            .church-navbar .nav-link::after { display: none; }
            .church-navbar .navbar-nav .nav-link { color: var(--church-navy) !important; padding: 0.5rem 0.5rem !important; border-bottom: 1px solid rgba(0,0,0,0.06); }
            .church-navbar .dropdown-menu { background: var(--church-cream); border: none; padding-left: 1rem; box-shadow: none; border-top: none; }
            .btn-nav-login { border-radius: 3px; margin: 0.5rem 0.5rem; display: inline-block; }
        }
        @media (max-width: 767px) {
            .page-hero { padding: 3rem 0 2.5rem; }
            .page-hero h1 { font-size: 1.8rem; }
        }
    </style>
    {% endblock %}
    {% block importmap %}{{ importmap('app') }}{% endblock %}
</head>
<body>
<div id="reading-progress" aria-hidden="true"></div>

{# ======== Top Bar ======== #}
<div class="church-topbar d-none d-md-block">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <i class="bi bi-geo-alt-fill me-1"></i> Dapitan City, Zamboanga del Norte, Philippines
            </div>
            <div>
                <i class="bi bi-clock me-1"></i> Lord's Day: Sunday 9:00 AM
                <span class="topbar-divider"></span>
                <i class="bi bi-envelope me-1"></i>
                <a href="mailto:tnews2090@gmail.com">tnews2090@gmail.com</a>
            </div>
        </div>
    </div>
</div>

{# ======== Navbar ======== #}
{% set current_route = app.request.attributes.get('_route') %}
<nav class="navbar navbar-expand-lg church-navbar sticky-top" id="mainNav">
    <div class="container">

        {# Brand #}
        <a class="navbar-brand" href="{{ path('app_home') }}">
            <div class="brand-logo" aria-hidden="true">
