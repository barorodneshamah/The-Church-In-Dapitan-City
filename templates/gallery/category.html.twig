{% extends 'base.html.twig' %}

{% block title %}{{ category_label }} — Gallery — The Church in Dapitan City{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .category-tabs { border-bottom: 2px solid var(--church-border); margin-bottom: 2rem; gap: 0.25rem; }
    .category-tabs .tab-btn { background: none; border: none; border-bottom: 3px solid transparent; color: var(--church-muted); font-family: var(--font-body); font-weight: 700; font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.6px; padding: 0.6rem 1.25rem; margin-bottom: -2px; cursor: pointer; transition: all 0.2s; text-decoration: none; display: inline-block; }
    .category-tabs .tab-btn:hover, .category-tabs .tab-btn.active { color: var(--church-navy); border-bottom-color: var(--church-gold); }
    .testimony-card { background: #fff; border: 1px solid var(--church-border); border-radius: 4px; padding: 2rem 1.75rem 1.75rem; position: relative; margin-bottom: 1.25rem; transition: box-shadow 0.25s; }
    .testimony-card:hover { box-shadow: 0 6px 20px rgba(0,0,0,0.07); }
    .testimony-card .quote-mark { font-family: var(--font-heading); font-size: 5rem; line-height: 1; color: var(--church-gold); opacity: 0.18; position: absolute; top: 0.75rem; left: 1.25rem; pointer-events: none; user-select: none; }
    .testimony-card .testimony-text { color: var(--church-text); font-size: 0.93rem; line-height: 1.75; margin-bottom: 1rem; position: relative; z-index: 1; }
    .testimony-card .testimony-author { display: flex; align-items: center; gap: 10px; }
    .testimony-card .author-avatar { width: 36px; height: 36px; background: var(--church-gold); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-weight: 700; font-size: 0.85rem; flex-shrink: 0; }
    .testimony-card .author-name { font-weight: 700; font-size: 0.88rem; color: var(--church-navy); display: block; }
    .testimony-card .author-category { font-size: 0.78rem; color: var(--church-muted); }
</style>
{% endblock %}

{% block body %}

{# Page Hero #}
<div class="page-hero">
    <div class="container">
        <div class="hero-eyebrow">Gallery &amp; Testimonies</div>
        <h1>{{ category_label }}</h1>
        <div class="page-hero-divider"></div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Home</a></li>
                <li class="breadcrumb-item"><a href="{{ path('app_gallery') }}">Gallery &amp; Testimonies</a></li>
                <li class="breadcrumb-item active">{{ category_label }}</li>
            </ol>
        </nav>
    </div>
</div>

{# Category Navigation #}
<div class="bg-white border-bottom py-2">
    <div class="container">
        <div class="d-flex flex-wrap gap-1 category-tabs">
            <a href="{{ path('app_gallery') }}" class="tab-btn">
                <i class="bi bi-images me-1"></i>All Photos
            </a>
            {% for slug, label in categories %}
                <a href="{{ path('app_gallery_category', {category: slug}) }}"
                   class="tab-btn {{ current_category == slug ? 'active' }}">
                    {{ label }}
                </a>
            {% endfor %}
        </div>
    </div>
</div>

{# Photos Section #}
<section class="py-5 bg-white">
    <div class="container py-3">

        {# Photos #}
        <div class="mb-5" data-animate>
            <div class="d-flex align-items-center gap-3 mb-4">
                <i class="bi bi-images fs-3" style="color:var(--church-gold);"></i>
                <div>
                    <p class="section-label mb-0">Gallery</p>
                    <h2 class="section-title mb-0" style="font-size:1.6rem;">{{ category_label }} Photos</h2>
                </div>
            </div>

            {% if photos is empty %}
                <div class="empty-state" style="background:var(--church-cream);border:1px solid var(--church-border);border-radius:4px;">
                    <i class="bi bi-images"></i>
                    <p>No photos in this category yet.</p>
                </div>
            {% else %}
                <p class="text-muted mb-3">{{ photos|length }} photo{{ photos|length != 1 ? 's' }}</p>
                <div class="gallery-grid">
                    {% for item in photos %}
                        <div class="gallery-thumb">
                            {% if item.imageFilename %}
                                <img src="{{ asset('uploads/gallery/' ~ item.imageFilename) }}"
                                     alt="{{ item.title }}" loading="lazy">
                                <div class="gallery-thumb-overlay">
                                    <h5>{{ item.title }}</h5>
                                </div>
                            {% else %}
                                <div class="gallery-thumb-placeholder">
                                    <i class="bi bi-image"></i>
                                    <span>{{ item.title }}</span>
                                </div>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        <hr class="divider-gold">

        {# Testimonies #}
        <div data-animate>
            <div class="d-flex align-items-center gap-3 mb-4">
                <i class="bi bi-chat-heart fs-3" style="color:var(--church-gold);"></i>
                <div>
                    <p class="section-label mb-0">Testimonies</p>
                    <h2 class="section-title mb-0" style="font-size:1.6rem;">{{ category_label }} Testimonies</h2>
                </div>
            </div>

            {% if testimonies is empty %}
                <div class="empty-state" style="background:var(--church-cream);border:1px solid var(--church-border);border-radius:4px;">
                    <i class="bi bi-chat-quote"></i>
                    <p>No testimonies in this category yet.</p>
                </div>
            {% else %}
                <div class="row g-3">
                    {% for item in testimonies %}
                        <div class="col-md-6">
                            <div class="testimony-card">
                                <div class="quote-mark">&ldquo;</div>
                                <p class="testimony-text">{{ item.description ?? item.title }}</p>
                                <div class="testimony-author">
                                    <div class="author-avatar">
                                        {{ (item.author ?? 'S')|first|upper }}
                                    </div>
                                    <div>
                                        <span class="author-name">{{ item.author ?? 'A Saint' }}</span>
                                        <span class="author-category">{{ item.categoryLabel }}</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

    </div>
</section>

{% endblock %}
