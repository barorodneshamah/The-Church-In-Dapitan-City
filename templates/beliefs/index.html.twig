{% block javascripts %}
<script>
(function () {
    'use strict';

    // ── Staggered list item animation ────────────────────────────────
    const listEls = document.querySelectorAll('.belief-list');
    const listObs = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
            if (entry.isIntersecting) {
                entry.target.classList.add('list-visible');
                listObs.unobserve(entry.target);
            }
        });
    }, { threshold: 0.12 });
    listEls.forEach(function (el) { listObs.observe(el); });

    // ── Active TOC link on scroll ─────────────────────────────────────
    // Uses scroll position instead of IntersectionObserver so that very tall
    // sections (7, 8) are always highlighted correctly regardless of length.
    const sections = document.querySelectorAll('.belief-section[id]');
    const tocLinks = document.querySelectorAll('.beliefs-toc a');
    const NAV_OFFSET = 110;

    function updateActiveToc() {
        let activeId = null;
        sections.forEach(function (section) {
            if (section.getBoundingClientRect().top <= NAV_OFFSET) {
                activeId = section.id;
            }
        });
        tocLinks.forEach(function (link) {
            link.classList.toggle('toc-active', link.getAttribute('href') === '#' + activeId);
        });
    }

    window.addEventListener('scroll', updateActiveToc, { passive: true });
    updateActiveToc();

    // ── Smooth-scroll for TOC links ───────────────────────────────────
    tocLinks.forEach(function (link) {
        link.addEventListener('click', function (e) {
            const target = document.querySelector(this.getAttribute('href'));
            if (target) {
                e.preventDefault();
                target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        });
    });
})();
</script>
{% endblock %}
